---
/* Torty: the RAG section's pet, docked in the corner like Bittu on ML.

   She is deliberately NOT part of the pipeline rail. The rail on the left is
   navigation; Torty is the character who explains things, and every section of
   the site puts its character in the same corner so readers learn one place to
   look.

   She speaks through the shared mascot.js (`say`), which finds her by the
   data-mascot* hooks below. rail.js calls say() on every stage change, and the
   games mirror their MascotNote into the same bubble.

   Drawn side-on so the parts can genuinely retract: head, legs and tail are
   painted BEHIND the plastron and shell, so pulling them in hides them rather
   than shrinking them in place. turtle.js drives the data-shy state. */
interface Props { t: any }
const { t } = Astro.props;
---
<div class="torty-dock" data-mascot>
  <div class="torty-bubble" data-mascot-bubble aria-live="polite" hidden></div>

  <button class="torty-pet" data-mascot-poke type="button" aria-label={t.ui.petLabel}>
    <svg class="turtle" data-turtle data-shy="out" viewBox="0 0 64 52"
         xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">

      <!-- far pair of legs: darker, for a little depth -->
      <g class="turtle__legs-far">
        <rect class="turtle__leg-far" x="17" y="33" width="9" height="12" rx="4.5"/>
        <rect class="turtle__leg-far" x="28" y="33" width="9" height="12" rx="4.5"/>
      </g>

      <!-- tail -->
      <path class="turtle__tail" d="M8 34 L1.5 37 L8 40 Z"/>

      <!-- near pair of legs -->
      <g class="turtle__legs">
        <rect class="turtle__leg" x="10" y="33" width="12" height="14" rx="6"/>
        <rect class="turtle__leg" x="29" y="33" width="12" height="14" rx="6"/>
      </g>

      <!-- head + neck, drawn before the plastron so the neck tucks under it -->
      <g class="turtle__head">
        <rect class="turtle__neck" x="38" y="23" width="14" height="13" rx="6.5"/>
        <circle class="turtle__skull" cx="52" cy="28" r="10"/>
        <circle class="turtle__eyewhite" cx="54.5" cy="24.8" r="4.2"/>
        <circle class="turtle__pupil" cx="55.4" cy="25.2" r="2.4"/>
        <circle class="turtle__glint" cx="56.4" cy="24" r="1.1"/>
        <circle class="turtle__nostril" cx="59.4" cy="29.4" r=".85"/>
        <path class="turtle__smile" d="M48.6 32.4 q4.2 3.6 8.2 .6"/>
      </g>

      <!-- plastron: shallow, so it reads as a belly and not a band -->
      <rect class="turtle__belly" x="9" y="30.5" width="33" height="7.5" rx="3.75"/>

      <!-- shell: light rim dome, darker inner dome, scute plates -->
      <path class="turtle__rim" d="M2.5 33 A22.5 21.5 0 0 1 47.5 33 Z"/>
      <path class="turtle__dome" d="M7 32.5 A18 17.5 0 0 1 43 32.5 Z"/>
      <path class="turtle__scutes" d="M25 15.5 L33.5 22 L31.5 32.5 L18.5 32.5 L16.5 22 Z M16.5 22 L8 26.5 M33.5 22 L42 26.5"/>
    </svg>
    <span class="torty-name">Torty</span>
  </button>
</div>

<style>
  .torty-dock {
    position: fixed; right: clamp(8px, 2vw, 26px); bottom: clamp(8px, 2vw, 22px);
    z-index: 50; display: flex; align-items: flex-end; gap: 10px;
    pointer-events: none;
  }
  .torty-bubble {
    pointer-events: auto;
    max-width: min(40ch, 60vw);
    background: var(--panel); color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--teal) 45%, transparent);
    border-radius: 12px; padding: 11px 14px;
    font-size: 13px; line-height: 1.5;
    box-shadow: 0 10px 30px rgba(0, 0, 0, .45);
  }
  .torty-bubble[hidden] { display: none; }

  .torty-pet {
    pointer-events: auto;
    background: none; border: 0; padding: 0; cursor: pointer;
    width: clamp(74px, 10vw, 108px);
    display: grid; justify-items: center;
  }
  .torty-name {
    font-family: var(--mono); font-size: 9.5px; letter-spacing: .26em;
    text-transform: uppercase; color: var(--turtle-rim, #e0a457); margin-top: 2px;
  }

  /* She keeps her own warm palette in both themes: she is a character, not a
     UI accent, and green-and-amber reads against the teal page. */
  .turtle {
    --turtle-skin:      #6fbe4a;
    --turtle-skin-dk:   #4a8f30;
    --turtle-shell:     #9c5a20;
    --turtle-shell-lt:  #c2833a;
    --turtle-rim:       #e0a457;
    --turtle-belly:     #e8c98f;
    --turtle-line:      #2f2820;
    width: 100%; height: auto; display: block; overflow: visible;
  }

  .turtle__leg, .turtle__tail, .turtle__skull, .turtle__belly, .turtle__rim {
    stroke: var(--turtle-line); stroke-width: 1.5; stroke-linejoin: round;
  }
  .turtle__leg, .turtle__neck, .turtle__skull, .turtle__tail { fill: var(--turtle-skin); }
  .turtle__leg-far { fill: var(--turtle-skin-dk); }
  .turtle__belly { fill: var(--turtle-belly); }
  .turtle__rim   { fill: var(--turtle-rim); }
  .turtle__dome  { fill: var(--turtle-shell); }
  .turtle__scutes {
    fill: none; stroke: var(--turtle-shell-lt); stroke-width: 1.5;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .turtle__eyewhite { fill: #fff; stroke: var(--turtle-line); stroke-width: 1.1; }
  .turtle__pupil    { fill: var(--turtle-line); }
  .turtle__glint    { fill: #fff; }
  .turtle__nostril  { fill: var(--turtle-line); opacity: .65; }
  .turtle__smile {
    fill: none; stroke: var(--turtle-line); stroke-width: 1.4; stroke-linecap: round;
  }

  /* ---- the shy reflex ----
     Pulling in is a flinch; coming out is slow and staggered, legs before head. */
  .turtle__head, .turtle__legs, .turtle__legs-far, .turtle__tail { transform-box: fill-box; }
  .turtle__head      { transform-origin: 0% 55%; }
  .turtle__legs,
  .turtle__legs-far  { transform-origin: 50% 0%; }
  .turtle__tail      { transform-origin: 100% 50%; }

  .turtle[data-shy="in"] .turtle__head     { transform: translate(-13px, 1px) scale(.38); }
  .turtle[data-shy="in"] .turtle__legs     { transform: translateY(-10px) scaleY(.28); }
  .turtle[data-shy="in"] .turtle__legs-far { transform: translateY(-8px) scaleY(.28); }
  .turtle[data-shy="in"] .turtle__tail     { transform: translateX(7px) scaleX(.18); }

  @media (prefers-reduced-motion: no-preference) {
    .turtle[data-shy="in"] .turtle__head,
    .turtle[data-shy="in"] .turtle__legs,
    .turtle[data-shy="in"] .turtle__legs-far,
    .turtle[data-shy="in"] .turtle__tail {
      transition: transform .18s cubic-bezier(.4, 0, .9, .5);
    }
    .turtle[data-shy="out"] .turtle__legs,
    .turtle[data-shy="out"] .turtle__legs-far {
      transition: transform .8s cubic-bezier(.22, 1.05, .36, 1);
    }
    .turtle[data-shy="out"] .turtle__tail {
      transition: transform .7s cubic-bezier(.22, 1.05, .36, 1) .1s;
    }
    .turtle[data-shy="out"] .turtle__head {
      transition: transform 1s cubic-bezier(.22, 1.1, .36, 1) .26s;
    }
    /* she only breathes while she is out; a shut shell should sit still */
    .torty-pet:has(.turtle[data-shy="out"]) { animation: torty-bob 3.6s ease-in-out infinite; }
    @keyframes torty-bob { 50% { transform: translateY(-5px); } }
  }

  @media (max-width: 620px) {
    .torty-dock { flex-direction: column; align-items: flex-end; }
    .torty-bubble { max-width: 78vw; }
    .torty-pet { width: 68px; }
  }
</style>
