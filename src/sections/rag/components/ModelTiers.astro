---
/* Renders the embedding or LLM tier list. Tier reasoning (the labels) is
   localised prose; the dated example names live in data/current-models.json so
   updating them is a one-file edit. */
import models from '../data/current-models.json';
interface Props { kind: 'embedding' | 'llm'; t: any }
const { kind, t } = Astro.props;

const rows = kind === 'embedding'
  ? [
      { key: 'tier1', label: t.tiers.labels.tier1e },
      { key: 'tier2', label: t.tiers.labels.tier2e },
      { key: 'tier3', label: t.tiers.labels.tier3e },
      { key: 'tier4', label: t.tiers.labels.tier4e },
      { key: 'tier5', label: t.tiers.labels.tier5e },
    ]
  : [
      { key: 'tier1', label: t.tiers.labels.tier1 },
      { key: 'tier2', label: t.tiers.labels.tier2 },
      { key: 'tier3', label: t.tiers.labels.tier3 },
      { key: 'tier4', label: t.tiers.labels.tier4 },
    ];
const data = models[kind];
---
<div class="tiers">
  <div class="tiers__head">
    <span class="tiers__title">{kind === 'embedding' ? t.tiers.embeddingHeading : t.tiers.llmHeading}</span>
    <span class="tiers__verified">{t.ui.verifiedAs} {models.lastVerified}</span>
  </div>
  <ol class="tiers__list">
    {rows.map((r) => (
      <li class="tier">
        <span class="tier__label">{r.label}</span>
        <span class="tier__eg"><b>{data[r.key].name}</b> — {data[r.key].detail}</span>
      </li>
    ))}
  </ol>
  <p class="tiers__note" set:html={kind === 'llm' ? t.tiers.router : t.tiers.axis} />
  {kind === 'embedding' && (
    <p class="tiers__fixed">{t.tiers.fixedFactLabel} {models.fixedFacts[0]}</p>
  )}
</div>

<style>
  .tiers { margin: 24px 0; border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; background: var(--panel); }
  .tiers__head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 12px; }
  .tiers__title { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--teal); }
  .tiers__verified {
    font-family: var(--mono); font-size: 10px; letter-spacing: .06em;
    color: var(--marker); border: 1px solid color-mix(in srgb, var(--marker) 40%, transparent);
    border-radius: 999px; padding: 2px 8px;
  }
  .tiers__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .tier { display: grid; gap: 3px; }
  .tier__label { font-family: var(--mono); font-size: 12px; color: var(--ink); font-weight: 600; }
  .tier__eg { font-size: 13px; color: var(--ink-dim); line-height: 1.5; }
  .tier__eg b { color: var(--ink); font-weight: 600; }
  .tiers__note { font-size: 13px; color: var(--ink-dim); margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--line-soft); }
  .tiers__fixed { font-size: 12.5px; color: var(--ink-dim); margin: 8px 0 0; }
</style>
