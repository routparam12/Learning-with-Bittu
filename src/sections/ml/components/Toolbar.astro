---
const { locale, t } = Astro.props;
const other = locale === 'en' ? 'hi' : 'en';
---
<div class="toolbar" data-toolbar>
  <div class="lang" role="group" aria-label="Language">
    <a href={`/en/`} class="lang__opt" data-lang="en" aria-pressed={locale === 'en' ? 'true' : 'false'}>EN</a>
    <a href={`/hi/`} class="lang__opt" data-lang="hi" aria-pressed={locale === 'hi' ? 'true' : 'false'}>HI</a>
  </div>
  <button class="pill" data-sfx-toggle type="button" aria-pressed="true" aria-label={t.toolbar.sfxOff}>
    <span data-icon-on>🔊</span><span data-icon-off hidden>🔇</span>
  </button>
  <button class="pill" data-music-toggle type="button" aria-pressed="false" aria-label={t.toolbar.musicOn}>
    <span data-icon-on hidden>🎬</span><span data-icon-off>🎼</span>
  </button>
  <button class="pill" data-theme-toggle type="button" aria-pressed="false" aria-label={t.toolbar.themeLight}>
    <span data-icon-on hidden>☀️</span><span data-icon-off>🌙</span>
  </button>
</div>

<style>
  .toolbar {
    position: fixed; top: clamp(8px, 1.6vw, 16px); right: clamp(8px, 2vw, 20px);
    z-index: 60; display: flex; align-items: center; gap: 8px;
    background: rgba(20, 27, 22, .78);
    border: 1px solid var(--chalk-faint);
    border-radius: 999px;
    padding: 6px; backdrop-filter: blur(6px);
  }
  :root[data-theme="light"] .toolbar { background: rgba(255, 250, 240, .85); }

  .lang {
    display: flex; background: var(--board); border-radius: 999px; overflow: hidden;
    border: 1px solid var(--chalk-faint);
  }
  .lang__opt {
    font-family: var(--data); font-size: 12px; font-weight: 700; letter-spacing: .04em;
    padding: 7px 12px; color: var(--ink); text-decoration: none; cursor: pointer;
  }
  .lang__opt[aria-pressed="true"] { background: var(--chalk); color: var(--board); }

  .pill {
    display: grid; place-items: center; width: 34px; height: 34px;
    border-radius: 50%; border: 1px solid var(--chalk-faint); background: var(--board);
    cursor: pointer; font-size: 15px; padding: 0; line-height: 1;
    transition: transform .12s ease;
  }
  .pill:hover { transform: scale(1.08); }
  .pill[aria-pressed="false"] { opacity: .55; }

  @media (max-width: 620px) {
    .toolbar { top: 8px; right: 8px; padding: 5px; gap: 6px; }
    .pill { width: 30px; height: 30px; font-size: 13px; }
    .lang__opt { padding: 6px 9px; font-size: 11px; }
  }
</style>

<script>
  import { resumeAudio, sfxEnabled, musicEnabled, setSfxEnabled, setMusicEnabled, playPop } from '../../../shared/scripts/audio.js';

  const THEME_KEY = 'bittu-theme';

  // remember the section's language so the DSA section (and "/") lands you back here
  try { localStorage.setItem('bittu-lang', document.documentElement.lang === 'hi' ? 'hi' : 'en'); } catch (e) {}

  function paint(btn, on) {
    btn.setAttribute('aria-pressed', String(on));
    const onIcon = btn.querySelector('[data-icon-on]');
    const offIcon = btn.querySelector('[data-icon-off]');
    onIcon.hidden = !on;
    offIcon.hidden = on;
  }

  const sfxBtn = document.querySelector('[data-sfx-toggle]');
  const musicBtn = document.querySelector('[data-music-toggle]');
  const themeBtn = document.querySelector('[data-theme-toggle]');

  paint(sfxBtn, sfxEnabled());
  paint(musicBtn, musicEnabled());

  const savedTheme = localStorage.getItem(THEME_KEY);
  const isLight = savedTheme === 'light';
  document.documentElement.dataset.theme = isLight ? 'light' : 'dark';
  paint(themeBtn, isLight);

  sfxBtn.addEventListener('click', () => {
    const next = sfxBtn.getAttribute('aria-pressed') !== 'true';
    setSfxEnabled(next);
    paint(sfxBtn, next);
    if (next) { resumeAudio(); playPop(); }
  });

  musicBtn.addEventListener('click', () => {
    const next = musicBtn.getAttribute('aria-pressed') !== 'true';
    resumeAudio();
    setMusicEnabled(next);
    paint(musicBtn, next);
  });

  themeBtn.addEventListener('click', () => {
    const next = themeBtn.getAttribute('aria-pressed') !== 'true';
    document.documentElement.dataset.theme = next ? 'light' : 'dark';
    localStorage.setItem(THEME_KEY, next ? 'light' : 'dark');
    paint(themeBtn, next);
    window.dispatchEvent(new CustomEvent('bittu-theme-change'));
  });
</script>
