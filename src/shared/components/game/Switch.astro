---
/* Switch — the one toggle style. Game script reads `[data-switch]` by name. */
interface Props { name: string; label: string; checked?: boolean }
const { name, label, checked = false } = Astro.props;
---
<label class="switch">
  <input type="checkbox" class="switch__input" data-switch={name} name={name} checked={checked} />
  <span class="switch__track"><span class="switch__thumb"></span></span>
  <span class="switch__label">{label}</span>
</label>

<style>
  .switch { display: flex; align-items: center; gap: 10px; cursor: pointer; }
  .switch__input { position: absolute; opacity: 0; width: 0; height: 0; }
  .switch__track {
    flex: none; width: 38px; height: 22px; border-radius: 999px;
    background: var(--g-panel-2, #122428); border: 1px solid var(--g-line, #1c3339);
    transition: background .18s ease, border-color .18s ease;
    display: flex; align-items: center; padding: 2px;
  }
  .switch__thumb {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--g-ink-dim, #7c9599); transition: transform .18s ease, background .18s ease;
  }
  .switch__input:checked + .switch__track {
    background: color-mix(in srgb, var(--section-accent, #63c7cd) 30%, transparent);
    border-color: var(--section-accent, #63c7cd);
  }
  .switch__input:checked + .switch__track .switch__thumb {
    transform: translateX(16px); background: var(--section-accent, #63c7cd);
  }
  .switch__input:focus-visible + .switch__track { outline: 2px solid var(--section-accent, #63c7cd); outline-offset: 3px; }
  .switch__label {
    font-family: var(--g-mono, ui-monospace, monospace);
    font-size: 11px; letter-spacing: .06em; text-transform: uppercase;
    color: var(--g-ink-dim, #7c9599);
  }
</style>
