---
import '../styles/global.css';
import Bittu from '../components/Bittu.astro';
const { title = 'Learn ML with Bittu' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="A playable board where a pet named Bittu teaches machine learning one mini-game at a time." />
    <link rel="icon" href="/bittu.svg" />
  </head>
  <body>
    <div class="hud">
      <span class="hud__title">Bittu&rsquo;s ML board</span>
      <span data-hud-num>0/6</span>
      <div class="hud__bar"><div class="hud__fill" data-hud-fill></div></div>
      <span class="hud__treats" data-hud-treats>🦴 0</span>
      <button class="btn btn--ghost" data-reset style="font-size:12px;padding:2px 12px 4px">reset</button>
    </div>

    <main>
      <slot />
    </main>

    <Bittu />

    <script>
      import { boot, say } from '../scripts/game.js';
      boot();
      setTimeout(() => say("Hi, I am Bittu. Click any underlined word and I will explain it. Play the game in each chapter to unlock the next one.", 'happy'), 500);
    </script>
  </body>
</html>
