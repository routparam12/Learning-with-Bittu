---
// Chapter 3b — classification: predicting a category
---
<div class="game sketch sketch--alt" data-game="boundary">
  <p class="game__title">Mini-game 04 · Split the class in two</p>
  <p>
    Twenty-six students, each plotted by hours studied and hours slept. Filled dots passed,
    hollow dots did not. Tilt and slide the line until it separates them. Red rings are your mistakes.
  </p>

  <canvas data-canvas data-h="330" aria-label="Students plotted by study hours and sleep hours"></canvas>

  <div class="grid2">
    <div>
      <div class="slider">
        <label>tilt (m) = <span data-mv>0.00</span></label>
        <input type="range" min="-3" max="1" step="0.05" value="0" data-m />
      </div>
      <div class="slider">
        <label>height (c) = <span data-cv>6.00</span></label>
        <input type="range" min="0" max="20" step="0.25" value="6" data-c />
      </div>
    </div>
    <div>
      <p class="readout">accuracy: <b data-acc>—</b></p>
      <p class="readout">unlock at <b>24 / 26</b> correct</p>
      <p class="readout" data-hint>above the line = your model says “passed”</p>
    </div>
  </div>
</div>

<script>
  import { say, win, fitCanvas, axes, dot } from '../../scripts/game.js';

  const PTS = [[0.71,3.55,0],[6.89,6.12,1],[4.8,4.54,0],[7.17,4.64,1],[7.48,6.1,1],[3.91,4.84,0],
    [3.27,8.68,0],[8.5,4.27,1],[1.99,4.83,0],[7.46,3.62,1],[5.58,6.68,1],[9.29,6.7,1],[8.05,3.42,1],
    [3.81,5.58,0],[1.39,7.5,0],[4.44,5.82,0],[6.93,7.05,1],[3.81,3.98,0],[8.82,5.01,1],[6.29,5.09,0],
    [6.76,8.36,1],[8.04,6.87,1],[1.65,6.17,0],[8.62,8.58,1],[5.95,8.6,1],[5.54,7.78,1]];

  const cv = document.querySelector('[data-canvas]');
  const mIn = document.querySelector('[data-m]');
  const cIn = document.querySelector('[data-c]');
  const accOut = document.querySelector('[data-acc]');
  let solved = false;

  function draw() {
    const { ctx, w: cw, h: ch } = fitCanvas(cv);
    const pad = axes(ctx, cw, ch, 'hours studied', 'hours slept');
    const sx = (x) => pad + (x / 10) * (cw - pad - 12);
    const sy = (y) => (ch - pad) - ((y - 2) / 9) * (ch - pad - 14);
    const m = +mIn.value, c = +cIn.value;

    // shade the "passed" side
    ctx.save();
    ctx.beginPath();
    ctx.moveTo(sx(0), sy(c)); ctx.lineTo(sx(10), sy(m * 10 + c));
    ctx.lineTo(sx(10), sy(11)); ctx.lineTo(sx(0), sy(11)); ctx.closePath();
    ctx.fillStyle = 'rgba(110,231,135,.08)'; ctx.fill();
    ctx.restore();

    ctx.strokeStyle = '#6ee787'; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.moveTo(sx(0), sy(c)); ctx.lineTo(sx(10), sy(m * 10 + c)); ctx.stroke();

    let right = 0;
    PTS.forEach(([x, y, t]) => {
      const p = y > m * x + c ? 1 : 0;
      const ok = p === t;
      if (ok) right++;
      dot(ctx, sx(x), sy(y), '#cdf5da', 5, t === 1);
      if (!ok) dot(ctx, sx(x), sy(y), '#ff8079', 9, false);
    });

    document.querySelector('[data-mv]').textContent = m.toFixed(2);
    document.querySelector('[data-cv]').textContent = c.toFixed(2);
    accOut.textContent = `${right} / 26 · ${Math.round((right / 26) * 100)}%`;
    accOut.parentElement.classList.toggle('readout--bad', right < 24);

    if (right >= 24 && !solved) {
      solved = true;
      say('Same recipe as the price line, different output: a category instead of a number. That is classification. Everything on one side of the line gets one label — and the line is all the model really is.', 'party');
      win(4, 'Chapter 4 done. 🦴', 1);
    }
  }

  [mIn, cIn].forEach((el) => el.addEventListener('input', draw));
  window.addEventListener('resize', draw);
  draw();
</script>
