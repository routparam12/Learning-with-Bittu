---
const { n, eyebrow, title, locked = true, next } = Astro.props;
---
<section class="chapter wrap" data-chapter={n} data-locked={locked ? 'true' : undefined} id={`ch${n}`}>
  <div class="lock"><span>🔒</span>Finish the previous mini-game to open this</div>
  <p class="chapter__eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  <slot />
  {next && <button class="btn next-btn" data-next={next}>Next: chapter {next} →</button>}
</section>
