---
// Bittu: the pet who lives in the corner of the board and explains things.
---
<div class="bittu-dock">
  <div class="bubble sketch" data-bittu-bubble hidden></div>

  <button class="pet" data-bittu data-mood="happy" aria-label="Poke Bittu for a hint">
    <svg viewBox="0 0 120 128" role="img" aria-hidden="true">
      <!-- tail -->
      <path class="tail" d="M96 92 q18 -2 16 -18" fill="none" stroke="var(--bittu-dark)" stroke-width="5" stroke-linecap="round"/>
      <!-- antenna -->
      <line x1="60" y1="42" x2="60" y2="24" stroke="var(--bittu-dark)" stroke-width="4" stroke-linecap="round"/>
      <circle class="bulb" cx="60" cy="18" r="7" fill="var(--chalk)"/>
      <!-- ears -->
      <path d="M34 56 L40 30 L58 50 Z" fill="var(--bittu)" stroke="var(--bittu-dark)" stroke-width="3" stroke-linejoin="round"/>
      <path d="M86 56 L80 30 L62 50 Z" fill="var(--bittu)" stroke="var(--bittu-dark)" stroke-width="3" stroke-linejoin="round"/>
      <!-- body -->
      <ellipse cx="60" cy="78" rx="38" ry="33" fill="var(--bittu)" stroke="var(--bittu-dark)" stroke-width="3"/>
      <!-- feet -->
      <path d="M42 110 q6 8 14 2" fill="none" stroke="var(--bittu-dark)" stroke-width="3" stroke-linecap="round"/>
      <path d="M64 112 q6 8 14 2" fill="none" stroke="var(--bittu-dark)" stroke-width="3" stroke-linecap="round"/>
      <!-- eyes -->
      <circle cx="48" cy="72" r="10" fill="#0d1310"/>
      <circle cx="74" cy="72" r="10" fill="#0d1310"/>
      <circle data-pupil cx="48" cy="72" r="4" fill="var(--chalk)"/>
      <circle data-pupil cx="74" cy="72" r="4" fill="var(--chalk)"/>
      <!-- mouths -->
      <path class="m m-happy" d="M52 92 q9 8 18 0" fill="none" stroke="#0d1310" stroke-width="3" stroke-linecap="round"/>
      <path class="m m-think" d="M54 93 h14" fill="none" stroke="#0d1310" stroke-width="3" stroke-linecap="round"/>
      <ellipse class="m m-party" cx="61" cy="93" rx="9" ry="7" fill="#0d1310"/>
      <path class="m m-oops" d="M51 94 q6 -7 11 0 q5 7 10 0" fill="none" stroke="#0d1310" stroke-width="3" stroke-linecap="round"/>
    </svg>
    <span class="name">Bittu</span>
  </button>
</div>

<style>
  .bittu-dock {
    position: fixed; right: clamp(8px, 2vw, 26px); bottom: clamp(8px, 2vw, 22px);
    z-index: 50; display: flex; align-items: flex-end; gap: 10px;
    pointer-events: none;
  }
  .bubble {
    pointer-events: auto;
    max-width: min(42ch, 60vw);
    background: var(--board-2);
    border-color: var(--bittu);
    color: var(--ink);
    padding: 12px 16px 14px;
    font-size: .95rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, .5);
    min-height: 2.6em;
  }
  .pet {
    pointer-events: auto;
    background: none; border: 0; padding: 0; cursor: pointer;
    width: clamp(76px, 11vw, 112px);
    display: grid; justify-items: center;
    animation: bob 3.4s ease-in-out infinite;
  }
  .pet svg { width: 100%; height: auto; overflow: visible; }
  .name {
    font-family: var(--data); font-size: 10px; letter-spacing: .28em;
    text-transform: uppercase; color: var(--bittu); margin-top: -4px;
  }
  .tail { transform-origin: 96px 92px; animation: wag 1.1s ease-in-out infinite; }
  .bulb { opacity: .35; }

  .m { display: none; }
  [data-mood="happy"] .m-happy { display: block; }
  [data-mood="think"] .m-think { display: block; }
  [data-mood="think"] .bulb { opacity: 1; animation: blink 1s steps(2) infinite; }
  [data-mood="party"] .m-party { display: block; }
  [data-mood="party"] { animation: hop .5s ease-in-out 3; }
  [data-mood="party"] .bulb { opacity: 1; }
  [data-mood="oops"] .m-oops { display: block; }

  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @keyframes wag { 0%, 100% { transform: rotate(-10deg); } 50% { transform: rotate(14deg); } }
  @keyframes hop { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-16px) rotate(-6deg); } }
  @keyframes blink { 50% { opacity: .3; } }

  @media (max-width: 620px) {
    .bittu-dock { flex-direction: column; align-items: flex-end; }
    .bubble { max-width: 78vw; }
  }
</style>

<script>
  import { say } from '../scripts/game.js';

  const lines = [
    "Rule of the board: nothing here is magic. It is just numbers finding a pattern.",
    "Stuck? Move one slider all the way to each end and watch what breaks. That is debugging.",
    "Data is my food. Labels are the treats. Give me both and I get clever.",
    "If a model is right on the training data but wrong on new data, it memorised. It did not learn.",
    "Say the word out loud, then click it. I will tell you what it means.",
  ];
  document.querySelector('[data-bittu]')?.addEventListener('click', () => {
    say(lines[Math.floor(Math.random() * lines.length)], 'think');
  });
</script>
